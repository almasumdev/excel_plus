CLAUDE.md
benchmark/
scripts/
tool/
# Documentation website sources. Deployed to Firebase hosting, not
# part of the published package.
site/
docs/
doc/api/
# Local-only working files. .pubignore *replaces* .gitignore when publishing,
# so everything gitignored-but-present locally must also be excluded here.
.tmp/
.claude/
build/
pubspec.lock
*.code-workspace
example/android/
example/ios/
example/linux/
example/macos/
example/windows/
example/web/
example/build/
example/test/
test/
.github/
firebase.json
.firebaserc
# Stray local spreadsheets (e.g. manual Excel/LibreOffice test artifacts) must
# never ship in the package.
*.xlsx
# README references these via absolute raw.githubusercontent URLs, so they
# don't need to ship. images/logo.png and images/preview.png are the exception:
# both ship as pub.dev screenshots (declared in pubspec).
images/banner.png
images/benchmark.svg
images/logo.svg
